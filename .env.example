
# Database
DATABASE_URL=

# LLM
GEMINI_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# API mode (local by default, test requires injected fixtures)
MARKETPULSE_MODE=local

# Public demo only. Supply secrets through the hosting platform.
# The example intentionally leaves credentials unset and cannot start a demo.
MARKETPULSE_DEMO_PROJECT_REF=
MARKETPULSE_DEMO_DSN=
MARKETPULSE_DEMO_SSL_ROOT_CERT=
MARKETPULSE_DEMO_ORIGIN_SECRET=
MARKETPULSE_DEMO_ANALYSIS_ENABLED=false
MARKETPULSE_DEMO_CATALOG_PER_MINUTE=30
MARKETPULSE_DEMO_HISTORY_PER_MINUTE=20
MARKETPULSE_DEMO_CONCURRENCY=4

# Worker only
MARKETPULSE_DEMO_ORIGIN_URL=
