{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "marketpulse-public-demo",
  "main": "worker/public-demo.mjs",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build:public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "ratelimits": [
    { "name": "CATALOG_RATE_LIMIT", "namespace_id": "4401", "simple": { "limit": 30, "period": 60 } },
    { "name": "HISTORY_RATE_LIMIT", "namespace_id": "4402", "simple": { "limit": 20, "period": 60 } }
  ]
}
