
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "macropulse-public-demo",
  "main": "worker/public-demo.mjs",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "build": { "command": "npm run build:public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "MARKETPULSE_DEMO_MACRO_ENABLED": "true",
    "MACROPULSE_RESEARCH_ENABLED": "true",
    "MARKETPULSE_DEMO_ORIGIN_URL": "https://macropulse-online.onrender.com",
    "MACROPULSE_RESEARCH_HOSTNAME": "macropulse-public-demo.mauricio-casaco.workers.dev",
    "MACROPULSE_TURNSTILE_SITE_KEY": "0x4AAAAAAF_z3Ar3h_sLpPVu"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESEARCH_QUOTA",
        "class_name": "ResearchQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ResearchQuota"]
    }
  ],
  "ratelimits": [
    {
      "name": "CATALOG_RATE_LIMIT",
      "namespace_id": "4401",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "HISTORY_RATE_LIMIT",
      "namespace_id": "4402",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
