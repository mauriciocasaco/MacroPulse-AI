{
  "name": "marketpulse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src pwa vite.config.ts",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:public": "npm run typecheck && vite build --mode public-demo",
    "test:worker": "node --test worker/*.node-test.mjs",
    "test:browser": "node --test browser/macro-analyst.browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "jsdom": "31.0.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
